  "scripts": { "build:client": "node build-client.mjs" },
  "devDependencies": { "esbuild": "^0.24.2" },
  "engines": { "node": ">=22" },
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": { "platform": "web", "inject": ["dsh-better-sidebar"] }
  }
}
